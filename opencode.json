{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": {
    "ruff": {
      "command": [
        "uv",
        "tool",
        "run",
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py"
      ]
    },
    "latexindent": {
      "command": [
        "latexindent",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".tex"
      ]
    },
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".md",
        ".json",
        ".yml",
        ".yaml"
      ]
    }
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/AGENTS.md"
  ],
  "mcp": {
    "research-lab": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "/home/cady/personal/dp/research-lab",
        "research-lab-mcp",
        "--workspace",
        "/home/cady/personal/dp"
      ],
      "enabled": true,
      "timeout": 300000
    }
  },
  "permission": {
    "bash": "ask"
  }
}
