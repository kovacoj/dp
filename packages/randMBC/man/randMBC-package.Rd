\name{randMBC-package}
\alias{randMBC-package}
\alias{randMBC}
\title{randMBC: Randomized Multivariate Bias Correction Backend}
\description{Experimental thesis package for randomized low-rank covariance transport in multivariate bias correction. The current package exports a simulated floating-point rounding helper, randomized covariance approximation, a regularized covariance transport map, and a top-level prototype for dependence correction after marginal adjustment.}
\details{The package is intentionally narrow at this stage. It focuses on the numerical backend needed for thesis experiments rather than a full climate-facing user interface.}
